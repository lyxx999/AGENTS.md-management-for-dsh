{
  "name": "@lyxx/dsh-agents-md",
  "description": "DSH 指令文件（AGENTS.md）管理：在设置页创建/查看/编辑/删除全局与工作区指令文件，支持自定义全局目录、镜像同步与渲染预算告警",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "homepage": "https://github.com/lyxx999/AGENTS.md-management-for-dsh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyxx999/AGENTS.md-management-for-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/lyxx999/AGENTS.md-management-for-dsh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "agents-md",
    "instructions",
    "settings"
  ],
  "license": "MIT"
}
