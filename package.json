{
  "name": "@local/agents-md-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Manage global and per-workspace AGENTS.md instruction files from the Settings page.",
  "icon": "./icon.svg",
  "meta": {
    "title": "指令文件 (AGENTS.md)",
    "description": "在设置页管理全局与工作区 AGENTS.md 指令文件。"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./remote": "./remote.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "icon.svg",
    "index.js",
    "client.js",
    "remote.js"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-settings-general"],
      "external": ["@deepseek-ai/dsh-api-gateway/client"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-config-editor": { "optional": true },
    "@deepseek-ai/dsh-workspace": { "optional": true }
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
